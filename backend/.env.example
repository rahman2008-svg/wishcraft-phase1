# ============================================================================
# WishCraft Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Server ---
NODE_ENV=development
PORT=5000
API_VERSION=v1

# --- Client URLs (comma-separated list allowed for multiple environments) ---
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,https://wishcraft.vercel.app

# --- Database (PostgreSQL) ---
# Example (Render Postgres): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishcraft?schema=public

# --- JWT Authentication ---
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=wishcraft-api

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=wishcraft

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# --- Cookies ---
COOKIE_SECRET=replace_with_a_long_random_secret_for_signed_cookies
REFRESH_COOKIE_NAME=wishcraft_rt
