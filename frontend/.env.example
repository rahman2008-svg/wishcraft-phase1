# WishCraft Frontend — Environment Variables
# Copy to .env.local for local development. Vite only exposes variables
# prefixed with VITE_ to client code.

# In local dev this can stay as /api/v1 — the Vite dev server proxy
# (see vite.config.js) forwards it to the backend on localhost:5000.
# In production, point this at your deployed Render API, e.g.
# https://wishcraft-api.onrender.com/api/v1
VITE_API_URL=/api/v1
